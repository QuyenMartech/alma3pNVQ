#!/bin/bash
# =============================================================
# 3proxy IPv6 Installer for AlmaLinux 9
# Compatible with GCC 10+ using -fcommon
# HTTP proxy + SOCKS5
# v8 - Them bo chan doan mang 5 tang de xac dinh chinh xac
#      nguyen nhan proxy khong hoat dong (thay vi chi bao FAILED)
#      + Ho tro che do IPv4-only fallback neu /64 khong duoc route
# =============================================================

set -e

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: Script must be run as root."
    exit 1
fi

WORKDIR="/home/proxy-installer"
WORKDATA="${WORKDIR}/data.txt"
THREEPROXY_DIR="${WORKDIR}/3proxy-3proxy-0.8.6"
INSTALL_DIR="/usr/local/etc/3proxy"
BINARY="${INSTALL_DIR}/bin/3proxy"
IPV6_SCRIPT="${INSTALL_DIR}/bin/boot_ifconfig.sh"
CONFIG="${INSTALL_DIR}/3proxy.cfg"

mkdir -p "$WORKDIR"
cd "$WORKDIR"

random_string() {
    tr </dev/urandom -dc 'A-Za-z0-9' | head -c 8
    echo
}

# -------------------------------------------------------------
# Phat sinh IPv6 tu prefix 4 hextet dau
# -------------------------------------------------------------

HEX_ARRAY=(1 2 3 4 5 6 7 8 9 0 a b c d e f)

random_hex4() {
    echo "${HEX_ARRAY[$RANDOM % 16]}${HEX_ARRAY[$RANDOM % 16]}${HEX_ARRAY[$RANDOM % 16]}${HEX_ARRAY[$RANDOM % 16]}"
}

generate_ipv6() {
    local prefix="$1"
    echo "${prefix}:$(random_hex4):$(random_hex4):$(random_hex4):$(random_hex4)"
}

# -------------------------------------------------------------
# Tu tim card mang chinh
# -------------------------------------------------------------

detect_interface() {
    local iface

    iface=$(
        ip -4 route get 1.1.1.1 2>/dev/null |
        awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }'
    )

    if [ -z "$iface" ]; then
        iface=$(
            ip -o link show up |
            awk -F': ' '$2 != "lo" {print $2}' |
            cut -d'@' -f1 |
            head -n 1
        )
    fi

    echo "$iface"
}

ETH_MAIN="$(detect_interface)"

if [ -z "$ETH_MAIN" ]; then
    echo "ERROR: Cannot detect the main network interface."
    exit 1
fi

echo ">>> Main network interface: $ETH_MAIN"
echo ">>> SELinux status: $(getenforce 2>/dev/null || echo 'not installed')"

# -------------------------------------------------------------
# Cai dat 3proxy (fix loi GCC 10+ bang -fcommon)
# -------------------------------------------------------------

install_3proxy() {
    local url
    url="https://raw.githubusercontent.com/quayvlog/quayvlog/main/3proxy-3proxy-0.8.6.tar.gz"

    echo ">>> Downloading 3proxy source"

    rm -rf "$THREEPROXY_DIR"

    if ! wget -qO- "$url" | bsdtar -xf-; then
        echo "ERROR: Cannot download or extract 3proxy source."
        exit 1
    fi

    if [ ! -d "$THREEPROXY_DIR" ]; then
        echo "ERROR: Extracted 3proxy directory not found: $THREEPROXY_DIR"
        exit 1
    fi

    cd "$THREEPROXY_DIR"

    echo ">>> Cleaning old build files"
    make -f Makefile.Linux clean >/dev/null 2>&1 || true

    echo ">>> Building 3proxy with GCC compatibility flag -fcommon"
    if ! make -f Makefile.Linux CC="gcc -fcommon"; then
        echo "ERROR: 3proxy compilation failed."
        exit 1
    fi

    if [ ! -x "src/3proxy" ]; then
        echo "ERROR: 3proxy binary was not created."
        exit 1
    fi

    mkdir -p "$INSTALL_DIR/bin" "$INSTALL_DIR/logs" "$INSTALL_DIR/stat"
    install -m 0755 src/3proxy "$BINARY"

    chown -R 65535:65535 "$INSTALL_DIR/logs" "$INSTALL_DIR/stat"

    echo ">>> 3proxy binary installed successfully"

    cd "$WORKDIR"
}

# -------------------------------------------------------------
# Phat sinh du lieu proxy
# Format: USER/PASSWORD/IPv4/HTTP_PORT/IPv6
# -------------------------------------------------------------

generate_data() {
    shuf -i 10000-29999 -n "$COUNT" |
    sort -n |
    while read -r http_port; do
        echo "usr$(random_string)/pass$(random_string)/${IP4}/${http_port}/$(generate_ipv6 "$IP6")"
    done
}

# -------------------------------------------------------------
# Sinh script gan IPv6 tai /usr/local/etc/3proxy/bin
# -------------------------------------------------------------

generate_ipv6_script() {
    {
        echo '#!/bin/bash'
        awk -F "/" -v iface="$ETH_MAIN" \
            '{ print "ip -6 addr add " $5 "/64 dev " iface " nodad 2>/dev/null || true" }' \
            "$WORKDATA"
    } > "$IPV6_SCRIPT"

    chmod 0755 "$IPV6_SCRIPT"

    local lines
    lines="$(wc -l < "$IPV6_SCRIPT")"

    echo ">>> boot_ifconfig.sh generated: $lines lines at $IPV6_SCRIPT"

    if grep -q '\\' "$IPV6_SCRIPT"; then
        echo "ERROR: boot_ifconfig.sh contains literal backslash."
        exit 1
    fi

    if [ "$lines" -ne $((COUNT + 1)) ]; then
        echo "ERROR: boot_ifconfig.sh has $lines lines, expected $((COUNT + 1))."
        exit 1
    fi
}

# -------------------------------------------------------------
# Cau hinh 3proxy
# Thu tu: maxconn -> dns -> timeouts -> flush -> auth
#   -> LOG BLOCK (khi con la root) -> users -> setgid/setuid
#   -> cac dong proxy/socks
# -------------------------------------------------------------

generate_3proxy_config() {
    local maxconn

    maxconn=$((COUNT * 5 + 1000))
    [ "$maxconn" -gt 10000 ] && maxconn=10000

    cat > "$CONFIG" <<EOF
maxconn ${maxconn}

nscache 65535
nserver 1.1.1.1
nserver 8.8.8.8
nserver 9.9.9.9

timeouts 1 5 30 60 180 1800 15 60

flush
auth strong

log ${INSTALL_DIR}/logs/3proxy.log D
logformat "- +_L%t.%. %N.%p %E %U %C:%c %R:%r %O %I %h %T"
rotate 30

users $(awk -F "/" 'BEGIN{ORS=""} {print $1 ":CL:" $2 " "}' "$WORKDATA")

setgid 65535
setuid 65535

$(awk -F "/" '{
    print "auth strong"
    print "allow " $1
    print "proxy -6 -n -a -p" $4 " -i" $3 " -e" $5
    print "socks -6 -a -p" ($4 + 20000) " -i" $3 " -e" $5
}' "$WORKDATA")
EOF
}

# -------------------------------------------------------------
# Smoke test: chay thu 3proxy 3 giay
# -------------------------------------------------------------

smoke_test_config() {
    echo ">>> Smoke testing 3proxy config (3s)..."

    pkill -x 3proxy 2>/dev/null || true
    sleep 1

    "$BINARY" "$CONFIG" 2>"${WORKDIR}/smoke.err" &
    local test_pid=$!
    sleep 3

    if kill -0 "$test_pid" 2>/dev/null; then
        echo ">>> Smoke test PASSED - config is valid"
        kill "$test_pid" 2>/dev/null || true
        sleep 1
        pkill -x 3proxy 2>/dev/null || true
        return 0
    fi

    echo "============================================================"
    echo "ERROR: 3proxy exited immediately - CONFIG ERROR."
    cat "${WORKDIR}/smoke.err"
    echo "============================================================"
    exit 1
}

# -------------------------------------------------------------
# Lay IP public
# -------------------------------------------------------------

get_public_ips() {
    IP4="$(curl -4 -fsS --max-time 15 https://icanhazip.com | tr -d '\r\n')"

    IP6="$(
        curl -6 -fsS --max-time 15 https://icanhazip.com |
        tr -d '\r\n' |
        cut -f1-4 -d':'
    )"

    if [ -z "$IP4" ]; then
        echo "ERROR: Cannot detect public IPv4."
        exit 1
    fi

    echo ">>> Public IPv4: $IP4"
    if [ -n "$IP6" ]; then
        echo ">>> IPv6 prefix: ${IP6}::/64"
    else
        echo ">>> IPv6: khong co (se dung IPv4-only mode)"
    fi
}

# -------------------------------------------------------------
# Gioi han file descriptor
# -------------------------------------------------------------

configure_limits() {
    grep -qE '^\* soft nofile 65535$' /etc/security/limits.conf || \
        echo '* soft nofile 65535' >> /etc/security/limits.conf
    grep -qE '^\* hard nofile 65535$' /etc/security/limits.conf || \
        echo '* hard nofile 65535' >> /etc/security/limits.conf
}

# -------------------------------------------------------------
# systemd unit - Type=simple (3proxy chay foreground)
# -------------------------------------------------------------

create_systemd_service() {
    cat > /etc/systemd/system/3proxy.service <<EOF
[Unit]
Description=3proxy IPv6 proxy service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
TimeoutStartSec=30
ExecStartPre=/bin/bash ${IPV6_SCRIPT}
ExecStart=${BINARY} ${CONFIG}
ExecReload=/bin/kill -USR1 \$MAINPID
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable 3proxy
}

# -------------------------------------------------------------
# Firewall
# -------------------------------------------------------------

configure_firewall() {
    echo ">>> Configuring firewalld"

    systemctl enable --now firewalld

    if ! systemctl is-active --quiet firewalld; then
        echo "ERROR: firewalld is not running."
        exit 1
    fi

    firewall-cmd --permanent --add-port=10000-29999/tcp 2>/dev/null
    firewall-cmd --permanent --add-port=30000-49999/tcp 2>/dev/null
    firewall-cmd --reload

    echo ">>> Opened HTTP ports: 10000-29999/tcp"
    echo ">>> Opened SOCKS5 ports: 30000-49999/tcp"
}

# -------------------------------------------------------------
# Gan IPv6 va kiem tra
# -------------------------------------------------------------

apply_ipv6_addresses() {
    if [ -z "$IP6" ]; then
        echo ">>> Bo qua gan IPv6 (IPv4-only mode)"
        return 0
    fi

    echo ">>> Applying IPv6 addresses"
    bash "$IPV6_SCRIPT"
    sleep 2

    local assigned
    assigned="$(ip -6 addr show dev "$ETH_MAIN" | grep -c 'inet6' || true)"
    echo ">>> IPv6 addresses currently assigned: $assigned"

    if [ "$assigned" -lt 2 ]; then
        echo "WARNING: IPv6 gan that bai - se kiem tra o buoc chan doan."
    fi
}

# -------------------------------------------------------------
# Xuat danh sach proxy
# -------------------------------------------------------------

generate_proxy_lists() {
    awk -F "/" '{print $3 ":" $4 ":" $1 ":" $2}' "$WORKDATA" \
        > "${WORKDIR}/proxy_http.txt"

    awk -F "/" '{print $3 ":" ($4 + 20000) ":" $1 ":" $2}' "$WORKDATA" \
        > "${WORKDIR}/proxy_socks5.txt"

    chmod 0600 "${WORKDIR}/proxy_http.txt" "${WORKDIR}/proxy_socks5.txt"

    echo ">>> HTTP list:   ${WORKDIR}/proxy_http.txt"
    echo ">>> SOCKS5 list: ${WORKDIR}/proxy_socks5.txt"
}

# -------------------------------------------------------------
# [v8 MOI] Bo chan doan mang 5 tang
# Tang 1: 3proxy co LISTEN dung port khong?
# Tang 2: Port co bi firewall OS chan khong?
# Tang 3: IPv6 exit co bind duoc khong?
# Tang 4: IPv6 co ra duoc internet khong? (route /64)
# Tang 5: Request qua proxy co thanh cong khong?
# -------------------------------------------------------------

diagnose_network() {
    local first_line user pass ip port socks_port ipv6_exit
    first_line="$(head -n 1 "$WORKDATA")"
    user="$(echo "$first_line" | cut -d/ -f1)"
    pass="$(echo "$first_line" | cut -d/ -f2)"
    ip="$(echo "$first_line"   | cut -d/ -f3)"
    port="$(echo "$first_line" | cut -d/ -f4)"
    socks_port=$((port + 20000))
    ipv6_exit="$(echo "$first_line" | cut -d/ -f5)"

    echo ""
    echo "========================================================"
    echo "  NETWORK DIAGNOSTICS - Phan tich 5 tang"
    echo "========================================================"

    # --- Tang 1: 3proxy LISTEN ---
    echo ""
    echo "[TANG 1] 3proxy co dang LISTEN tren port $port?"
    if ss -lnt | grep -q ":${port} "; then
        echo "  [OK] Port $port dang LISTEN"
    else
        echo "  [FAIL] Port $port KHONG LISTEN - 3proxy khong bind duoc"
        echo "  Kiem tra: journalctl -u 3proxy -n 20"
        return 1
    fi

    # --- Tang 2: firewall OS ---
    echo ""
    echo "[TANG 2] Firewall OS co cho phep port $port?"
    if firewall-cmd --list-ports 2>/dev/null | grep -q "10000-29999"; then
        echo "  [OK] firewalld da mo dai 10000-29999/tcp"
    else
        echo "  [FAIL] firewalld chua mo port - kiem tra: firewall-cmd --list-ports"
    fi

    # --- Tang 3: IPv6 exit co ton tai tren interface khong ---
    echo ""
    echo "[TANG 3] IPv6 exit $ipv6_exit co duoc gan tren $ETH_MAIN?"
    if ip -6 addr show dev "$ETH_MAIN" | grep -q "$ipv6_exit"; then
        echo "  [OK] IPv6 $ipv6_exit da duoc gan"
    else
        echo "  [FAIL] IPv6 $ipv6_exit KHONG ton tai tren $ETH_MAIN"
        echo "  Kiem tra: bash $IPV6_SCRIPT"
        return 1
    fi

    # --- Tang 4: IPv6 exit co ra duoc internet khong ---
    echo ""
    echo "[TANG 4] IPv6 $ipv6_exit co route ra internet?"
    local test_v6
    test_v6=$(curl -6 -sS --max-time 10 --interface "$ipv6_exit" https://api64.ipify.org 2>/dev/null || echo "FAILED")

    if [ "$test_v6" != "FAILED" ] && [ -n "$test_v6" ]; then
        echo "  [OK] IPv6 ra internet thanh cong: $test_v6"
    else
        echo "  [FAIL] IPv6 $ipv6_exit KHONG ra duoc internet"
        echo ""
        echo "  ============================================"
        echo "  NGUYEN NHAN: Provider (Vultr) CHUA route /64"
        echo "  ve VPS nay. IPv6 duoc gan nhung khong co"
        echo "  duong di tren internet."
        echo ""
        echo "  CACH KHAC PHUC:"
        echo "  1. Dang nhap Vultr Panel -> VPS -> Settings"
        echo "     -> IPv6 -> kiem tra co 'Routed Subnet'"
        echo "  2. Neu chi co 1 IPv6 /128: lien he support"
        echo "     yeu cau route ca /64 ve VPS"
        echo "  3. Hoac chuyen sang che do IPv4-only"
        echo "     (proxy van hoat dong, exit bang IPv4)"
        echo "  ============================================"
        echo ""
        read -r -p "Ban co muon chuyen sang IPv4-only mode? (y/n): " V4_ONLY
        if [[ "$V4_ONLY" =~ ^[Yy]$ ]]; then
            convert_to_ipv4_only
            return 2
        fi
        return 1
    fi

    # --- Tang 5: Test qua proxy ---
    echo ""
    echo "[TANG 5] Test request thuc qua proxy..."

    local result_http result_socks
    result_http=$(curl -4 -sS --max-time 20 \
        --proxy "http://${user}:${pass}@${ip}:${port}" \
        https://api.ipify.org 2>/dev/null || echo "FAILED")

    result_socks=$(curl -4 -sS --max-time 20 \
        --socks5-hostname "${user}:${pass}@${ip}:${socks_port}" \
        https://api.ipify.org 2>/dev/null || echo "FAILED")

    if [ "$result_http" != "FAILED" ] && [ -n "$result_http" ]; then
        echo "  [OK] HTTP proxy hoat dong - Exit IP: $result_http"
    else
        echo "  [FAIL] HTTP proxy khong hoat dong"
    fi

    if [ "$result_socks" != "FAILED" ] && [ -n "$result_socks" ]; then
        echo "  [OK] SOCKS5 proxy hoat dong - Exit IP: $result_socks"
    else
        echo "  [FAIL] SOCKS5 proxy khong hoat dong"
    fi

    if [ "$result_http" = "FAILED" ] && [ "$result_socks" = "FAILED" ]; then
        echo ""
        echo "  Proxy van khong hoat dong du 4 tang tren deu OK."
        echo "  Nguyen nhan co the: Cloud Firewall tren Vultr Panel"
        echo "  dang chan port ${port}. Kiem tra:"
        echo "  Vultr Panel -> VPS -> Firewall -> Them rule allow TCP 10000-29999"
        return 1
    fi

    echo ""
    echo "  >>> TAT CA 5 TANG DEU OK <<<"
    return 0
}

# -------------------------------------------------------------
# [v8 MOI] Chuyen sang IPv4-only mode (proxy exit bang IPv4)
# -------------------------------------------------------------

convert_to_ipv4_only() {
    echo ""
    echo ">>> Chuyen sang IPv4-only mode..."
    echo ">>> Tat ca proxy se exit bang IPv4: $IP4"

    # Sinh lai config khong co -6 va -e IPv6
    local maxconn
    maxconn=$((COUNT * 5 + 1000))
    [ "$maxconn" -gt 10000 ] && maxconn=10000

    cat > "$CONFIG" <<EOF
maxconn ${maxconn}

nscache 65535
nserver 1.1.1.1
nserver 8.8.8.8
nserver 9.9.9.9

timeouts 1 5 30 60 180 1800 15 60

flush
auth strong

log ${INSTALL_DIR}/logs/3proxy.log D
logformat "- +_L%t.%. %N.%p %E %U %C:%c %R:%r %O %I %h %T"
rotate 30

users $(awk -F "/" 'BEGIN{ORS=""} {print $1 ":CL:" $2 " "}' "$WORKDATA")

setgid 65535
setuid 65535

$(awk -F "/" '{
    print "auth strong"
    print "allow " $1
    print "proxy -n -a -p" $4 " -i" $3 " -e" $3
    print "socks -a -p" ($4 + 20000) " -i" $3 " -e" $3
}' "$WORKDATA")
EOF

    systemctl restart 3proxy
    sleep 3

    if systemctl is-active --quiet 3proxy; then
        echo ">>> 3proxy restarted in IPv4-only mode"

        # Test lai
        local first_line user pass ip port
        first_line="$(head -n 1 "$WORKDATA")"
        user="$(echo "$first_line" | cut -d/ -f1)"
        pass="$(echo "$first_line" | cut -d/ -f2)"
        ip="$(echo "$first_line"   | cut -d/ -f3)"
        port="$(echo "$first_line" | cut -d/ -f4)"

        local result
        result=$(curl -4 -sS --max-time 20 \
            --proxy "http://${user}:${pass}@${ip}:${port}" \
            https://api.ipify.org 2>/dev/null || echo "FAILED")

        if [ "$result" != "FAILED" ] && [ -n "$result" ]; then
            echo ">>> IPv4-only proxy OK! Exit IP: $result"
        else
            echo ">>> IPv4-only proxy van FAILED - kiem tra Cloud Firewall tren panel"
        fi
    else
        echo ">>> ERROR: 3proxy khong start duoc sau khi chuyen IPv4-only"
        journalctl -u 3proxy --no-pager -n 20
    fi
}

# =============================================================
# MAIN
# =============================================================

echo ">>> Installing required packages"

dnf -y install \
    gcc make curl wget bsdtar zip \
    iproute net-tools firewalld nftables \
    nmap-ncat procps-ng \
    >/dev/null

get_public_ips

read -r -p "How many proxy pairs do you want to create? Example: 500: " COUNT

if ! [[ "$COUNT" =~ ^[0-9]+$ ]] || [ "$COUNT" -lt 1 ]; then
    echo "ERROR: COUNT must be a positive integer."
    exit 1
fi

if [ "$COUNT" -gt 20000 ]; then
    echo "ERROR: Maximum supported count is 20000."
    exit 1
fi

echo ">>> Number of proxy pairs: $COUNT"
echo ">>> HTTP port range: 10000-29999"
echo ">>> SOCKS5 port range: 30000-49999"

install_3proxy

echo ">>> Generating proxy data"
generate_data > "$WORKDATA"

if [ ! -s "$WORKDATA" ]; then
    echo "ERROR: Proxy data file is empty."
    exit 1
fi

generate_ipv6_script
generate_3proxy_config

smoke_test_config

configure_limits
create_systemd_service
apply_ipv6_addresses
configure_firewall

echo ">>> Starting 3proxy"

pkill -x 3proxy 2>/dev/null || true
sleep 1

if ! systemctl restart 3proxy; then
    echo "ERROR: 3proxy failed to start."
    systemctl status 3proxy --no-pager || true
    journalctl -u 3proxy --no-pager -n 30 || true
    exit 1
fi

sleep 3

if ! systemctl is-active --quiet 3proxy; then
    echo "ERROR: 3proxy is not active after restart."
    journalctl -u 3proxy --no-pager -n 30
    exit 1
fi

echo ">>> 3proxy is running (PID: $(pgrep -x 3proxy | head -1))"

generate_proxy_lists

echo
echo ">>> First proxy entries:"
head -n 5 "${WORKDIR}/proxy_http.txt"

# Chay bo chan doan 5 tang
diagnose_network

echo
echo "============================================================="
echo "Installation completed."
echo "HTTP list:   ${WORKDIR}/proxy_http.txt"
echo "SOCKS5 list: ${WORKDIR}/proxy_socks5.txt"
echo "Config:      ${CONFIG}"
echo "IPv6 script: ${IPV6_SCRIPT}"
echo "Logs:        ${INSTALL_DIR}/logs/3proxy.log"
echo "============================================================="
